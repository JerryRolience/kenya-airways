model Passenger {
    id             String            @id @default(cuid())
    userId         String?
    title          String? // "Mr", "Mrs", "Ms", "Dr"
    firstName      String
    lastName       String
    email          String
    phone          String
    passportNumber String
    nationality    String
    dateOfBirth    DateTime
    relationship   PassengerRelation @default(SELF)
    createdAt      DateTime          @default(now())
    updatedAt      DateTime          @updatedAt

    user              User?              @relation(fields: [userId], references: [id])
    bookingPassengers BookingPassenger[]

    // Prevent the same person being added twice under the same account
    @@unique([userId, passportNumber])
    @@map("passengers")
}
