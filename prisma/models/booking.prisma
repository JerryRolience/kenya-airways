model Booking {
    id             String        @id @default(cuid())
    reference      String        @unique // e.g. KQ-2026-XKZT 
    userId         String
    flightId       String
    seatClassId    String
    returnFlightId String? // null for one-way trips
    isReturnTrip   Boolean       @default(false)
    status         BookingStatus @default(PENDING)
    totalAmount    Float
    paymentStatus  PaymentStatus @default(UNPAID)
    createdAt      DateTime      @default(now())
    updatedAt      DateTime      @updatedAt

    user         User               @relation(fields: [userId], references: [id])
    flight       Flight             @relation(fields: [flightId], references: [id])
    seatClass    SeatClass          @relation(fields: [seatClassId], references: [id])
    returnFlight Flight?            @relation("ReturnFlight", fields: [returnFlightId], references: [id])
    passengers   BookingPassenger[]
    payment      Payment?

    @@map("bookings")
}
