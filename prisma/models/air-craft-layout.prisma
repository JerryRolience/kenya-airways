// ─── AIRCRAFT LAYOUT TEMPLATE ───
// Defines the seat map for a type of aircraft (reusable across flights)
model AircraftLayout {
    id           String @id @default(cuid())
    aircraftType String @unique // e.g. "Boeing 737-800", "Boeing 787-8"

    // Executive (Class A) config
    execRowStart    Int // e.g. 1
    execRowEnd      Int // e.g. 4
    execSeatsPerRow Int // e.g. 4  → columns A B C D
    execColumns     String // e.g. "A,B,C,D"

    // Middle (Class B) config
    midRowStart    Int // e.g. 5
    midRowEnd      Int // e.g. 14
    midSeatsPerRow Int // e.g. 6  → columns A B C D E F
    midColumns     String // e.g. "A,B,C,D,E,F"

    // Economy (Class C) config
    ecoRowStart    Int // e.g. 15
    ecoRowEnd      Int // e.g. 34
    ecoSeatsPerRow Int // e.g. 6
    ecoColumns     String // e.g. "A,B,C,D,E,F"

    flights Flight[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()

    @@map("aircraft_layouts")
}
